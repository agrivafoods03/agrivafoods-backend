PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/agrivafoods
ATLAS_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/agrivafoods?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Automatic Admin Email Notifications (SMTP / Gmail / SendGrid / Amazon SES)
ADMIN_NOTIFICATION_EMAIL=admin@agrivafoods.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM_EMAIL=notifications@agrivafoods.com
SMTP_SECURE=false
