PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/agrivafoods
ATLAS_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/agrivafoods?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Automatic Admin Email Notifications (SMTP)
ADMIN_NOTIFICATION_EMAIL=admin@agrivafoods.com
# Use port 587 (SMTP_SECURE=false for STARTTLS) or 465 (SMTP_SECURE=true for SSL/TLS).
# NOTE: Render blocks outbound port 25.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM_EMAIL=notifications@agrivafoods.com
SMTP_SECURE=false

# Provider Examples:
# For Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=your_account@gmail.com
#   SMTP_PASS=your_16_char_google_app_password
#   SMTP_FROM_EMAIL=your_account@gmail.com
#
# For Brevo (Sendinblue):
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=your_brevo_login_email
#   SMTP_PASS=your_brevo_smtp_key
#   SMTP_FROM_EMAIL=your_verified_sender_email
